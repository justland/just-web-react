{
	"name": "@just-web/react-commands",
	"version": "9.1.1",
	"description": "@just-web/commands UI components in react",
	"keywords": [
		"just-web",
		"framework",
		"react"
	],
	"homepage": "https://github.com/justland/just-web-react/tree/main/components/react-commands",
	"bugs": {
		"url": "https://github.com/justland/just-web-react/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/justland/just-web-react.git",
		"directory": "components/commands"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/just-web-react-commands.d.mts",
				"default": "./dist/just-web-react-commands.mjs"
			},
			"require": {
				"types": "./dist/just-web-react-commands.d.cts",
				"default": "./dist/just-web-react-commands.cjs"
			},
			"default": "./dist/just-web-react-commands.mjs"
		}
	},
	"main": "./dist/just-web-react-commands.cjs",
	"module": "./dist/just-web-react-commands.mjs",
	"types": "./dist/just-web-react-commands.d.mts",
	"files": [
		"dist",
		"src",
		"!**/*.spec.*",
		"!**/*.stories.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:storybook": "storybook build",
		"check": "biome check",
		"clean": "rimraf coverage dist dts --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"dev": "vite",
		"nuke": "rimraf node_modules",
		"preview": "vite preview",
		"sb": "storybook dev -p 6007",
		"size": "size-limit",
		"test": "vitest run",
		"test:tsc": "tsc --noEmit",
		"test:watch": "vitest",
		"verify": "npm-run-all -p check build coverage -p size"
	},
	"dependencies": {
		"react-command-palette": "~0.22.0",
		"type-plus": "^7.0.1"
	},
	"devDependencies": {
		"@just-web/app": "^7.3.2",
		"@just-web/browser-keyboard": "^8.5.1",
		"@just-web/commands": "^7.3.3",
		"@just-web/keyboard": "^7.3.3",
		"@just-web/os": "^7.3.2",
		"@just-web/react": "workspace:^",
		"@repobuddy/typescript": "^2.1.0",
		"@size-limit/preset-small-lib": "~8.2.0",
		"@storybook/addon-docs": "^10.1.11",
		"@storybook/addon-links": "^10.1.11",
		"@storybook/react-vite": "^10.1.11",
		"@types/jest-image-snapshot": "^6.1.0",
		"@types/mousetrap": "~1.6.11",
		"@types/react": "^16.14.43",
		"@types/react-dom": "^16.9.19",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"jest-image-snapshot": "^6.2.0",
		"mousetrap": "~1.6.5",
		"npm-run-all2": "^5.0.0",
		"react": "^16.14.0",
		"react-dom": "^16.14.0",
		"rimraf": "~5.0.0",
		"size-limit": "~8.2.0",
		"storybook": "^10.1.11",
		"tsdown": "^0.17.4",
		"typescript": "^5.0.0",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@just-web/app": "^7.0.0",
		"@just-web/browser-keyboard": "^8.0.0",
		"@just-web/commands": "^7.0.0",
		"@just-web/keyboard": "^7.0.0",
		"@just-web/os": "^7.0.0",
		"@just-web/react": "workspace:^",
		"react": "^16 || ^17 || ^18",
		"react-dom": "^16 || ^17 || ^18"
	}
}
