{
  "name": "react-freedom",
  "version": "1.1.3",
  "homepage": "https://github.com/justland/just-web-react/tree/main/components/freedom",
  "bugs": {
    "url": "https://github.com/justland/just-web-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justland/just-web-react.git",
    "directory": "components/freedom"
  },
  "license": "MIT",
  "author": {
    "name": "Homa Wong (unional)",
    "email": "homawong@gmail.com",
    "url": "https://github.com/unional"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsdown",
    "build:docs": "storybook build",
    "check": "biome check",
    "clean": "rimraf coverage cjs dist dts esm --glob *.tsbuildinfo",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "nuke": "run-s clean nuke:local",
    "nuke:local": "rimraf node_modules",
    "sb": "storybook dev -p 6008",
    "size": "size-limit",
    "test": "vitest run",
    "verify": "npm-run-all -p check depcheck build coverage -p size",
    "w": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.0.2",
    "@repobuddy/typescript": "^2.1.0",
    "@size-limit/preset-small-lib": "~8.2.0",
    "@storybook/addon-a11y": "9.1.16",
    "@storybook/addon-console": "^3.0.0",
    "@storybook/addon-coverage": "^0.0.9",
    "@storybook/addon-links": "9.1.16",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/react-vite": "9.1.16",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^18.0.0",
    "@types/react": "^16.14.43",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "^10.4.14",
    "delay": "^6.0.0",
    "jsdom": "^27.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.23",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "rimraf": "~5.0.0",
    "size-limit": "~8.2.0",
    "storybook": "9.1.16",
    "tailwindcss": "^3.3.1",
    "tsdown": "^0.17.4",
    "typescript": "^5.0.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@storybook/addon-docs": "9.1.16"
  },
  "peerDependencies": {
    "react": "^16 || ^17 || ^18",
    "react-dom": "^16 || ^17 || ^18"
  }
}
