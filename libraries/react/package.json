{
	"name": "@just-web/react",
	"version": "9.0.4",
	"description": "Supporting library for using @just-web with React",
	"keywords": [
		"just-web",
		"framework",
		"react"
	],
	"homepage": "https://github.com/justland/just-web-react/tree/main/libraries/react",
	"bugs": {
		"url": "https://github.com/justland/just-web-react/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/justland/just-web-react.git",
		"directory": "libraries/react"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing/index.d.mts",
				"default": "./dist/testing/index.mjs"
			},
			"require": {
				"types": "./dist/testing/index.d.cts",
				"default": "./dist/testing/index.cjs"
			},
			"default": "./dist/testing/index.mjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*",
		"!**/*.stories.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:storybook": "storybook build",
		"check": "biome check",
		"cov": "vitest run --coverage",
		"coverage": "vitest run --coverage",
		"clean": "rimraf coverage cjs esm dist dts --glob *.tsbuildinfo",
		"dev": "vite",
		"nuke": "rimraf node_modules",
		"preview": "vite preview",
		"sb": "storybook dev -p 6006",
		"sb:build": "storybook build",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:tsc": "tsc --noEmit",
		"verify": "npm-run-all -p check build coverage -p size"
	},
	"dependencies": {
		"@just-web/states": "^7.3.0",
		"type-plus": "^7.0.1"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.3",
		"@just-web/app": "^7.3.2",
		"@repobuddy/typescript": "^1.2.0",
		"@size-limit/preset-small-lib": "~8.2.0",
		"@storybook-community/storybook-dark-mode": "^7.0.3",
		"@storybook/addon-docs": "10.1.8",
		"@storybook/addon-links": "10.1.8",
		"@storybook/addon-vitest": "10.1.8",
		"@storybook/react-vite": "10.1.8",
		"@types/jest": "^29.2.3",
		"@types/jest-image-snapshot": "^6.1.0",
		"@types/node": "^18.0.0",
		"@types/react": "^16.14.43",
		"@types/react-dom": "^16.9.19",
		"@types/react-modal": "^3.13.1",
		"@types/react-test-renderer": "^18.0.0",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"assertron": "^11.5.2",
		"autoprefixer": "^10.4.14",
		"npm-run-all2": "^5.0.0",
		"postcss": "^8.4.23",
		"react": "^16.14.0",
		"react-dom": "^16.14.0",
		"react-modal": "^3.16.1",
		"react-test-renderer": "^16.14.0",
		"rimraf": "~5.0.0",
		"size-limit": "~8.2.0",
		"storybook": "10.1.8",
		"storybook-addon-tag-badges": "^3.0.4",
		"storybook-addon-vis": "^3.1.0",
		"tailwindcss": "^3.3.1",
		"tersify": "^3.12.1",
		"tsdown": "^0.17.4",
		"typescript": "^5.0.0",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@just-web/app": "^7.0.0",
		"@just-web/states": "^7.0.0",
		"react": "^16 || ^17 || ^18",
		"react-dom": "^16 || ^17 || ^18"
	}
}
